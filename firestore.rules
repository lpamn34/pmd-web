rules_version = '2';
// 불가사의 던전 웹: Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여 넣고 "게시"한다 (개발용·서비스용 프로젝트 둘 다)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function shortName(n) { return n is string && n.size() > 0 && n.size() <= 16; }
    // 닉네임은 names/{소문자 닉네임} 문서로 먼저 차지한 사람만 쓸 수 있다 (겹치기·사칭 방지)
    function ownsName(n) {
      return shortName(n) && get(/databases/$(database)/documents/names/$(n.lower())).data.uid == request.auth.uid;
    }

    match /names/{name} {
      allow read: if true;
      allow create: if signedIn() && name.size() <= 16
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 계정별 정보와 클라우드 세이브: 본인만 읽고 쓴다
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'id', 'created', 'save', 'savedAt', 'ver'])
        && (!('name' in request.resource.data) || ownsName(request.resource.data.name))
        && (!('save' in request.resource.data) || (request.resource.data.save is string && request.resource.data.save.size() < 400000));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'id', 'created', 'save', 'savedAt', 'ver'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || ownsName(request.resource.data.name))
        && (!('save' in request.resource.data) || (request.resource.data.save is string && request.resource.data.save.size() < 400000));
    }

    // 구조 게시판
    match /sos/{id} {
      allow read: if signedIn();
      // 요청 올리기: 본인 이름으로, 열린 상태로만
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'name', 'dungeon', 'floor', 'sp', 'lv', 'shiny', 'ver', 'key', 'status', 'created'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.status == 'open'
        && ownsName(request.resource.data.name)
        && request.resource.data.floor is int && request.resource.data.sp is int && request.resource.data.lv is int;
      allow update: if signedIn() && (
        // 구조: 다른 사람이, 열린 요청을 구조됨으로 (한 번만)
        (resource.data.status == 'open' && resource.data.owner != request.auth.uid
          && request.resource.data.status == 'rescued'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'key', 'rescuer'])
          && request.resource.data.rescuer.keys().hasOnly(['uid', 'name', 'sp', 'lv', 'shiny'])
          && request.resource.data.rescuer.uid == request.auth.uid
          && ownsName(request.resource.data.rescuer.name))
        ||
        // 구조하러 간다: 다른 사람이, 열린 요청을 2시간 동안 맡는다 (아무도 안 맡았거나, 맡은 지 2시간이 지났거나, 내가 맡은 것)
        (resource.data.status == 'open' && resource.data.owner != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['takenBy', 'takenAt'])
          && request.resource.data.takenBy == request.auth.uid && request.resource.data.takenAt == request.time
          && (resource.data.get('takenBy', null) == null || resource.data.takenBy == request.auth.uid
              || resource.data.takenAt < request.time - duration.value(2, 'h')))
        ||
        // 맡은 구조를 취소: 맡은 사람이 풀어 준다
        (resource.data.status == 'open' && resource.data.get('takenBy', null) == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['takenBy', 'takenAt'])
          && request.resource.data.takenBy == null && request.resource.data.takenAt == null)
        ||
        // 감사 편지: 요청자가, 구조된 요청에 한 번만
        (resource.data.status == 'rescued' && resource.data.owner == request.auth.uid
          && request.resource.data.status == 'thanked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'thx'])
          && (request.resource.data.thx == null || (request.resource.data.thx is string && request.resource.data.thx.size() <= 24)))
      );
      // 지우기: 요청자는 아직 아무도 구조하지 않았을 때 (포기), 구조한 사람은 감사 편지를 받은 뒤 (정리)
      allow delete: if signedIn() && (
        (resource.data.owner == request.auth.uid && resource.data.status == 'open')
        || (resource.data.status == 'thanked' && resource.data.rescuer.uid == request.auth.uid)
      );
    }
  }
}
